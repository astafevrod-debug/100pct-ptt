\section{Введение}
\begin{frame}{Введение}
    \begin{block}{Что такое оптически активные вещества?}
        \textbf{Оптически активные вещества} — это вещества, способные вращать плоскость поляризации проходящего через них линейно поляризованного света.
    \end{block}

    \begin{exampleblock}{Примеры ОАВ}
        \begin{itemize}
            \item Кварц
            \item Никотин
            \item Сахара (глюкоза, фруктоза)
            \item Винная кислота
            \item Многие терпены (скипидар, лимонен)
        \end{itemize}
    \end{exampleblock}

    \begin{alertblock}{Важность}
        Явление используется в химии, фармакологии, пищевой промышленности (сахариметрия) для определения концентрации и идентификации веществ.
    \end{alertblock}
\end{frame}

\section{История открытия}
\begin{frame}{История открытия}
    \begin{columns}
        \begin{column}{0.6\textwidth}
            \begin{itemize}
                \item \textbf{1811 г.} — Французский физик \textbf{Доминик Франсуа Араго} обнаружил вращение плоскости поляризации в кристалле кварца.
                \item \textbf{1815 г.} — \textbf{Жан-Батист Био} установил, что это явление наблюдается и в жидкостях (скипидар, растворы сахара).
                \item \textbf{1848 г.} — \textbf{Луи Пастер} открыл, что оптическая активность связана с \textbf{молекулярной хиральностью}. Он разделил кристаллы винной кислоты на два изомера, вращающие свет в разные стороны.
            \end{itemize}
        \end{column}
