    \end{exampleblock}
\end{frame}

\section{Количественное описание}
\begin{frame}{Количественное описание: Закон Био}
    \begin{block}{Закон Био}
        Угол вращения плоскости поляризации $\varphi$ пропорционален длине пути света в веществе $l$ и концентрации вещества $c$ (для растворов).
        \[
        \varphi = [\alpha]_{\lambda}^{T} \cdot l \cdot c
        \]
        \begin{itemize}
            \item $\varphi$ — измеренный угол вращения (в градусах).
            \item $l$ — длина кюветы (в дециметрах, дм).
            \item $c$ — концентрация вещества (в г/мл для чистых жидкостей или г/100 мл для растворов).
            \item $[\alpha]_{\lambda}^{T}$ — \textbf{Удельное вращение} — постоянная для данного вещества.
        \end{itemize}
    \end{block}

    \begin{alertblock}{Зависимость удельного вращения}
        Удельное вращение $[\alpha]$ зависит от \textbf{температуры} $T$, \textbf{длины волны света} $\lambda$ (дисперсия оптического вращения) и \textbf{растворителя}.
    \end{alertblock}
\end{frame}

\section{Методы измерения и приборы}
\begin{frame}{Методы измерения и приборы}
    \begin{block}{Поляриметр}
        Основной прибор для измерения угла вращения — \textbf{поляриметр}.
    \end{block}

    \begin{figure}
        \includegraphics[width=0.9\textwidth]{polarimeter_scheme.png} % Замените на свое изображение
        \centering
        \caption{Упрощенная схема поляриметра.}
    \end{figure}

    \begin{itemize}
        \item \textbf{Источник света} (часто натриевая лампа, $\lambda=589$ нм).
        \item \textbf{Поляризатор} — создает плоско-поляризованный свет.
        \item \textbf{Кювета} с исследуемым веществом.
        \item \textbf{Анализатор} — второй поляризатор, поворотом которого компенсируют вращение и находят угол $\varphi$.
    \end{itemize}
\end{frame}

\section{Применение}
\begin{frame}{Применение}
    \begin{columns}
        \begin{column}{0.5\textwidth}
            \begin{block}{Сахарометрия}
                \textbf{Определение концентрации сахаров} в растворах (в пищевой промышленности, биохимии).
                \[
                c = \frac{\varphi}{[\alpha] \cdot l}
                \]
            \end{block}
            \begin{block}{Химия и фармакология}
                \begin{itemize}
                    \item Идентификация и характеристика хиральных соединений.
                    \item Контроль чистоты энантиомеров в лекарствах (т.к. разные изомеры могут иметь разную биологическую активность).
                \end{itemize}
            \end{block}
        \end{column}
        \begin{column}{0.5\textwidth}
            \begin{block}{Исследовательские методы}
                \begin{itemize}
                    \item \textbf{Поляриметрия}
                    \item \textbf{Круговой дихроизм}
                    \item \textbf{Оптическая ротационная дисперсия (ОРД)}
                \end{itemize}
                Эти методы позволяют изучать структуру белков, нуклеиновых кислот и других биополимеров.
            \end{block}
